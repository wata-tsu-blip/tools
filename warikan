                                                </div>

                                                <div className="flex items-center justify-between w-full md:w-auto gap-3 self-stretch md:self-auto border-t md:border-t-0 pt-2 md:pt-0 border-slate-100">
                                                    <span className="font-black text-slate-900 text-base md:text-lg mr-2">
                                                        ¥ {exp.amount.toLocaleString()}
                                                    </span>
                                                    
                                                    <div className="flex items-center gap-1.5 shrink-0">
                                                        <button
                                                            onClick={() => startEditExpense(exp)}
                                                            className="text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 p-1.5 rounded-lg transition"
                                                            title="この支出を編集"
                                                        >
                                                            <IconEdit2 className="h-4 w-4" />
                                                        </button>
                                                        <button
                                                            onClick={() => handleRemoveExpense(exp.id)}
                                                            className="text-slate-400 hover:text-red-500 hover:bg-red-50 p-1.5 rounded-lg transition"
                                                            title="この支出を削除"
                                                        >
                                                            <IconTrash2 className="h-4 w-4" />
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    })}

                                    {expenses.length === 0 && (
                                        <div className="text-center py-12 border border-dashed border-slate-200 rounded-2xl bg-slate-50/50">
                                            <div className="text-slate-300 mb-2">💸</div>
                                            <p className="text-sm text-slate-500 font-medium">登録された支出はありません</p>
                                            <p className="text-xs text-slate-400 mt-1">支出を追加するか、「デモ」を押してください。</p>
                                        </div>
                                    )}
                                </div>
                            </section>

                        </div>

                        {/* 右側：可視化と送金ルート */}
                        <div className="lg:col-span-5 flex flex-col gap-6 md:gap-8">
                            
                            {/* STEP 3: 計算結果の可視化 */}
                            <section className="bg-white p-5 md:p-6 rounded-2xl shadow-lg border border-slate-100 ring-2 ring-indigo-600/5">
                                <div className="flex items-center gap-2 mb-4 border-b border-slate-100 pb-3">
                                    <span className="flex items-center justify-center w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">3</span>
                                    <h2 className="text-lg font-bold text-slate-800">収支バランス・可視化</h2>
                                </div>

                                {members.length < 2 ? (
                                    <div className="py-12 text-center">
                                        <IconUsers className="h-10 w-10 text-slate-300 mx-auto mb-2" />
                                        <p className="text-sm text-slate-500 font-bold">メンバー登録を2名以上にしてください</p>
                                        <p className="text-xs text-slate-400 mt-1">自動で清算ルートと個別収支が計算されます。</p>
                                    </div>
                                ) : (
                                    <>
                                        {/* 個人の収支プログレスバー */}
                                        <div className="space-y-4 mb-6">
                                            <h3 className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">各メンバーの現状と差額</h3>
                                            
                                            <div className="space-y-3 max-h-80 overflow-y-auto pr-1">
                                                {calculations.memberBalances.map(mb => {
                                                    const isCreditor = mb.balance > 0;
                                                    const isDebtor = mb.balance < 0;
                                                    const absBalance = Math.abs(mb.balance);
                                                    
                                                    const maxAbsBalance = Math.max(...calculations.memberBalances.map(x => Math.abs(x.balance)), 1) || 1;
                                                    const barWidth = `${Math.min((absBalance / maxAbsBalance) * 100, 100)}%`;

                                                    return (
                                                        <div key={mb.id} className="space-y-1.5 p-3 rounded-xl hover:bg-slate-50 transition border border-slate-100/50 bg-white shadow-sm">
                                                            <div className="flex justify-between items-center">
                                                                <div className="flex items-center gap-1.5 min-w-0">
                                                                    <span className="font-bold text-slate-800 text-sm truncate">{mb.name}</span>
                                                                    <span className="text-[10px] text-slate-400 shrink-0">
                                                                        (払: ¥{mb.paid.toLocaleString()} / 負: ¥{Math.round(mb.share).toLocaleString()})
                                                                    </span>
                                                                </div>
                                                                
                                                                <div className={`text-xs font-bold px-2 py-0.5 rounded-full shrink-0 ${
                                                                    isCreditor 
                                                                        ? 'bg-emerald-50 text-emerald-700' 
                                                                        : 'isDebtor' 
                                                                            ? 'bg-rose-50 text-rose-600' 
                                                                            : 'bg-slate-100 text-slate-500'
                                                                }`}>
                                                                    {isCreditor && `+ ¥${absBalance.toLocaleString()}`}
                                                                    {isDebtor && `- ¥${absBalance.toLocaleString()}`}
                                                                    {!isCreditor && !isDebtor && '清算完了'}
                                                                </div>
                                                            </div>

                                                            {/* 視覚的インジケーターバー */}
                                                            <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden flex">
                                                                {isCreditor ? (
                                                                    <div className="flex justify-start w-full">
                                                                        <div className="h-full bg-emerald-500 rounded-full transition-all duration-500" style={{ width: barWidth }}></div>
                                                                    </div>
                                                                ) : isDebtor ? (
                                                                    <div className="flex justify-end w-full">
                                                                        <div className="h-full bg-rose-500 rounded-full transition-all duration-500" style={{ width: barWidth }}></div>
                                                                    </div>
                                                                ) : (
                                                                    <div className="w-full h-full bg-slate-200"></div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        </div>

                                        {/* 送金おすすめ手順 */}
                                        <div className="border-t border-slate-100 pt-5">
                                            <div className="flex items-center justify-between mb-4">
                                                <h3 className="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                                                    <IconAward className="h-4.5 w-4.5 text-indigo-600" />
                                                    おすすめの精算送金ルート
                                                </h3>
                                                <span className="text-xs text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md font-semibold">
                                                    送金回数: {calculations.transactions.length}回
                                                </span>
                                            </div>

                                            {calculations.transactions.length > 0 ? (
                                                <div className="space-y-3 max-h-60 overflow-y-auto pr-1">
                                                    {calculations.transactions.map((t, idx) => (
                                                        <div 
                                                            key={idx} 
                                                            className="bg-indigo-50/50 border border-indigo-100 rounded-xl p-3.5 flex items-center justify-between gap-2 shadow-sm relative overflow-hidden"
                                                        >
                                                            <div className="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-indigo-50/30 to-transparent pointer-events-none" />
                                                            
                                                            <div className="flex items-center gap-2 z-10 flex-1 min-w-0">
                                                                <div className="bg-rose-100 text-rose-700 w-7 h-7 rounded-full flex items-center justify-center font-black text-[10px] shrink-0" title="支払う人">
                                                                    出
                                                                </div>
                                                                <span className="font-bold text-slate-800 text-sm truncate">{t.from}</span>
                                                                
                                                                <IconArrowRight className="h-4 w-4 text-indigo-400 shrink-0 mx-1" />
                                                                
                                                                <div className="bg-emerald-100 text-emerald-700 w-7 h-7 rounded-full flex items-center justify-center font-black text-[10px] shrink-0" title="受け取る人">
                                                                    受
                                                                </div>
                                                                <span className="font-bold text-slate-800 text-sm truncate">{t.to}</span>
                                                            </div>

                                                            <div className="text-right shrink-0 z-10">
                                                                <span className="block text-[10px] text-slate-400 font-semibold">送金額</span>
                                                                <span className="text-sm md:text-base font-black text-indigo-700">
                                                                    ¥{t.amount.toLocaleString()}
                                                                </span>
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            ) : (
                                                <div className="text-center py-8 bg-slate-50 border border-dashed border-slate-200 rounded-xl">
                                                    <p className="text-sm text-slate-500 font-semibold">💰 送金の必要はありません</p>
                                                    <p className="text-xs text-slate-400 mt-1">登録された支出がないか、全員が完全に清算済みです。</p>
                                                </div>
                                            )}

                                            {/* 結果のコピーボタン */}
                                            {calculations.transactions.length > 0 && (
                                                <button
                                                    onClick={copyResultsToClipboard}
                                                    className={`w-full mt-5 font-bold py-3 rounded-xl text-sm transition flex items-center justify-center gap-2 shadow-md ${
                                                        copied 
                                                            ? 'bg-emerald-600 hover:bg-emerald-700 text-white' 
                                                            : 'bg-indigo-600 hover:bg-indigo-700 text-white'
                                                    }`}
                                                >
                                                    {copied ? (
                                                        <>
                                                            <IconCheck className="h-4.5 w-4.5" />
                                                            コピーしました！そのまま送れます
                                                        </>
                                                    ) : (
                                                        <>
                                                            <IconCopy className="h-4.5 w-4.5" />
                                                            結果をコピーしてLINE等に送る
                                                        </>
                                                    )}
                                                </button>
                                            )}
                                        </div>
                                    </>
                                )}
                            </section>

                            {/* クイック統計情報 */}
                            <section className="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                                <h3 className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">統計・アドバイス</h3>
                                <div className="grid grid-cols-2 gap-4">
                                    <div className="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                        <span className="text-xs text-slate-400 block font-medium">1人あたりの平均負担</span>
                                        <span className="text-base font-bold text-slate-800">
                                            ¥ {members.length > 0 ? Math.round(calculations.totalExpense / members.length).toLocaleString() : 0}
                                        </span>
                                    </div>
                                    <div className="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                        <span className="text-xs text-slate-400 block font-medium">登録された支出</span>
                                        <span className="text-base font-bold text-slate-800">
                                            {expenses.length} 件
                                        </span>
                                    </div>
                                </div>

                                <div className="mt-4 flex gap-2 items-start bg-indigo-50/40 p-3 rounded-xl border border-indigo-50 text-indigo-900/80">
                                    <IconInfo className="h-4 w-4 shrink-0 text-indigo-500 mt-0.5" />
                                    <div className="text-xs leading-relaxed space-y-1">
                                        <p>💡 <strong>GitHub Pagesで公開中！</strong></p>
                                        <p>このページをお気に入り登録しておくと、旅行や飲み会の最中でもいつでもスマートフォンから割り勘の確認ができます。</p>
                                    </div>
                                </div>
                            </section>

                        </div>

                    </main>
                </div>
            );
        }

        // React18 マウント
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
