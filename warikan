    <!-- React/JSX アプリケーションコード -->
    <script type="text/babel">
        const { useState, useMemo, useEffect } = React;

        // --- カスタム SVG アイコン（Lucideの代わりに軽量・オフライン対応のSVGを内蔵） ---
        const IconUsers = ({ className = "h-5 w-5" }) => (
