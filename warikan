        const IconSave = ({ className = "h-5 w-5" }) => (
            <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V8l-4-4H8zm4 12a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
        );


        // --- メイン App コンポーネント ---
        function App() {
            // メンバーリスト
            const [members, setMembers] = useState([
                { id: '1', name: '佐藤' },
                { id: '2', name: '鈴木' },
                { id: '3', name: '田中' },
                { id: '4', name: '渡辺' },
            ]);
            const [newMemberName, setNewMemberName] = useState('');
            const [editingMemberId, setEditingMemberId] = useState(null);
            const [editingMemberName, setEditingMemberName] = useState('');

            // 支出リスト
            const [expenses, setExpenses] = useState([
                {
                    id: 'e1',
                    title: 'コテージ宿泊代',
                    amount: 40000,
                    payerId: '1',
                    participants: ['1', '2', '3', '4'],
                },
                {
                    id: 'e2',
                    title: 'BBQ食材・お酒',
                    amount: 15000,
                    payerId: '2',
                    participants: ['1', '2', '3', '4'],
                },
                {
                    id: 'e3',
                    title: 'レンタカー・ガソリン代',
                    amount: 9000,
                    payerId: '3',
                    participants: ['1', '2', '3'],
                }
            ]);

            // 新規・編集支出フォームの一時ステータス
            const [expenseTitle, setExpenseTitle] = useState('');
            const [expenseAmount, setExpenseAmount] = useState('');
            const [expensePayerId, setExpensePayerId] = useState('1');
            const [expenseParticipants, setExpenseParticipants] = useState(['1', '2', '3', '4']);
            const [isSelectAllParticipants, setIsSelectAllParticipants] = useState(true);
            
            // 編集中の支出ID (nullの場合は新規追加モード)
            const [editingExpenseId, setEditingExpenseId] = useState(null);

            // インポート・エクスポート用モーダルとテキスト
            const [showBackupModal, setShowBackupModal] = useState(false);
            const [backupText, setBackupText] = useState('');
            const [importText, setImportText] = useState('');

            // 通知・メッセージ
            const [copied, setCopied] = useState(false);
            const [backupCopied, setBackupCopied] = useState(false);
            const [errorMessage, setErrorMessage] = useState('');
            const [successMessage, setSuccessMessage] = useState('');

            // メンバー追加処理
            const handleAddMember = (e) => {
                if (e) e.preventDefault();
                const name = newMemberName.trim();
                if (!name) return;
                
                if (members.length >= 100) {
                    showError('メンバーは最大100人まで登録できます。');
                    return;
                }

                if (members.some(m => m.name === name)) {
                    showError('すでに同じ名前のメンバーが登録されています。');
                    return;
                }

                const newId = crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substr(2, 9);
                const newMember = { id: newId, name };
                
                setMembers([...members, newMember]);
                setNewMemberName('');
                setExpenseParticipants(prev => [...prev, newId]);
            };

            // メンバー名の編集開始
            const startEditMember = (member) => {
                setEditingMemberId(member.id);
                setEditingMemberName(member.name);
            };

            // メンバー名変更保存
            const saveMemberName = (id) => {
                const name = editingMemberName.trim();
                if (!name) {
                    setEditingMemberId(null);
                    return;
                }
                if (members.some(m => m.name === name && m.id !== id)) {
                    showError('すでに同じ名前のメンバーが登録されています。');
                    return;
                }

                setMembers(members.map(m => m.id === id ? { ...m, name } : m));
                setEditingMemberId(null);
            };

            // メンバー削除
            const handleRemoveMember = (id) => {
                const updatedMembers = members.filter(m => m.id !== id);
                setMembers(updatedMembers);
                
                const fallbackPayerId = updatedMembers[0]?.id || '';
                
                setExpenses(expenses.map(exp => {
                    let updatedExp = { ...exp };
                    if (exp.payerId === id) {
                        updatedExp.payerId = fallbackPayerId;
                    }
                    updatedExp.participants = exp.participants.filter(pId => pId !== id);
                    return updatedExp;
                }).filter(exp => exp.participants.length > 0 && exp.payerId !== ''));

                if (expensePayerId === id) {
                    setExpensePayerId(fallbackPayerId);
                }
                setExpenseParticipants(expenseParticipants.filter(pId => pId !== id));
            };

            // 支出の編集モード切り替え
            const startEditExpense = (expense) => {
                setEditingExpenseId(expense.id);
                setExpenseTitle(expense.title);
                setExpenseAmount(expense.amount.toString());
                setExpensePayerId(expense.payerId);
                setExpenseParticipants([...expense.participants]);
                setIsSelectAllParticipants(expense.participants.length === members.length);
                
                const formElement = document.getElementById('expense-form-section');
                if (formElement) {
                    formElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            };

            // 編集キャンセルの処理
            const cancelEditExpense = () => {
                setEditingExpenseId(null);
                setExpenseTitle('');
                setExpenseAmount('');
                setExpensePayerId(members[0]?.id || '');
                setExpenseParticipants(members.map(m => m.id));
                setIsSelectAllParticipants(true);
            };

            // 支出追加・更新の処理
            const handleSaveExpense = (e) => {
                e.preventDefault();

                if (members.length < 2) {
                    showError('支出を追加するには、まずメンバーを2人以上登録してください。');
                    return;
                }

                const title = expenseTitle.trim() || '共同の支出';
                const amount = parseFloat(expenseAmount);

                if (isNaN(amount) || amount <= 0) {
                    showError('有効な金額を入力してください。');
                    return;
                }

                if (!expensePayerId) {
                    showError('支払った人を選択してください。');
                    return;
                }

                if (expenseParticipants.length === 0) {
                    showError('支払いを負担する対象者を1人以上選択してください。');
                    return;
                }

                if (editingExpenseId) {
                    setExpenses(expenses.map(exp => 
                        exp.id === editingExpenseId 
                            ? { ...exp, title, amount, payerId: expensePayerId, participants: [...expenseParticipants] }
                            : exp
                    ));
                    showSuccess('支出情報を更新しました！');
                    setEditingExpenseId(null);
                } else {
                    const newId = crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substr(2, 9);
                    const newExpense = {
                        id: newId,
                        title,
                        amount,
                        payerId: expensePayerId,
                        participants: [...expenseParticipants]
                      };
                    setExpenses([...expenses, newExpense]);
                    showSuccess('支出を追加しました！');
                }
                
                setExpenseTitle('');
                setExpenseAmount('');
                setExpenseParticipants(members.map(m => m.id));
                setIsSelectAllParticipants(true);
            };

            // 支出の削除
            const handleRemoveExpense = (id) => {
                if (editingExpenseId === id) {
                    cancelEditExpense();
                }
                setExpenses(expenses.filter(exp => exp.id !== id));
            };

            // 参加者チェックの切り替え
            const toggleParticipant = (memberId) => {
                if (expenseParticipants.includes(memberId)) {
                    const updated = expenseParticipants.filter(id => id !== memberId);
                    setExpenseParticipants(updated);
                    setIsSelectAllParticipants(updated.length === members.length);
                } else {
                    const updated = [...expenseParticipants, memberId];
                    setExpenseParticipants(updated);
                    setIsSelectAllParticipants(updated.length === members.length);
                }
            };

            // 全員選択・解除の切り替え
            const toggleSelectAllParticipants = () => {
                if (isSelectAllParticipants) {
                    setExpenseParticipants([]);
                    setIsSelectAllParticipants(false);
                } else {
                    setExpenseParticipants(members.map(m => m.id));
                    setIsSelectAllParticipants(true);
                }
            };

            // デモデータの読み込み
            const loadDemoData = () => {
                setEditingExpenseId(null);
                setMembers([
                    { id: '1', name: '佐藤' },
                    { id: '2', name: '鈴木' },
                    { id: '3', name: '田中' },
                    { id: '4', name: '渡辺' },
                    { id: '5', name: '伊藤' },
                ]);
                setExpenses([
                    { id: 'e1', title: 'グランピング宿泊代', amount: 65000, payerId: '1', participants: ['1', '2', '3', '4', '5'] },
                    { id: 'e2', title: 'バーベキュー高級肉・食材', amount: 18000, payerId: '2', participants: ['1', '2', '3', '4', '5'] },
                    { id: 'e3', title: '地酒・ワイン（お酒飲む人限定）', amount: 8000, payerId: '3', participants: ['1', '2', '3'] },
                    { id: 'e4', title: 'レンタカー＆ガソリン往復', amount: 12000, payerId: '4', participants: ['1', '2', '4', '5'] },
                    { id: 'e5', title: '翌朝の淹れ立てコーヒー代', amount: 2500, payerId: '5', participants: ['1', '3', '5'] }
                ]);
                setExpensePayerId('1');
                setExpenseParticipants(['1', '2', '3', '4', '5']);
                setIsSelectAllParticipants(true);
                showSuccess('デモデータを読み込みました。');
            };

            // データをすべてクリア（0名リセット）
            const clearAllData = () => {
                setEditingExpenseId(null);
                setMembers([]);
                setExpenses([]);
                setExpensePayerId('');
                setExpenseParticipants([]);
                setIsSelectAllParticipants(false);
                showSuccess('データを完全にリセットしました。');
            };

            // エラー表示
            const showError = (msg) => {
                setErrorMessage(msg);
                setTimeout(() => setErrorMessage(''), 4000);
            };

            // 成功トースト表示
            const showSuccess = (msg) => {
                setSuccessMessage(msg);
                setTimeout(() => setSuccessMessage(''), 3000);
            };

            // エクスポート（バックアップ）作成
            const handleOpenBackupModal = () => {
                const dataToBackup = {
                    v: '1.0',
                    members,
                    expenses
                };
                // 日本語を崩さずにbase64に安全エンコード
                const stringified = btoa(unescape(encodeURIComponent(JSON.stringify(dataToBackup))));
                setBackupText(stringified);
                setImportText('');
                setShowBackupModal(true);
            };

            // インポート実行
            const handleImportData = () => {
                if (!importText.trim()) {
                    showError('インポートする文字列を入力してください。');
                    return;
                }
                try {
                    const decoded = decodeURIComponent(escape(atob(importText.trim())));
                    const parsed = JSON.parse(decoded);
                    
                    if (parsed && Array.isArray(parsed.members)) {
                        setMembers(parsed.members);
                        setExpenses(parsed.expenses || []);
                        setEditingExpenseId(null);
                        setShowBackupModal(false);
                        showSuccess('過去の割り勘データを復元しました！');
                    } else {
                        showError('データ形式が正しくありません。');
                    }
                } catch (e) {
                    showError('データの解析に失敗しました。正しい復元用コードを貼り付けてください。');
                }
            };

            // クリップボードにバックアップをコピー
            const copyBackupToClipboard = () => {
                const tempTextArea = document.createElement('textarea');
                tempTextArea.value = backupText;
                document.body.appendChild(tempTextArea);
                tempTextArea.select();
                try {
                    document.execCommand('copy');
                    setBackupCopied(true);
                    setTimeout(() => setBackupCopied(false), 3000);
                } catch (err) {
                    console.error('コピー失敗', err);
                }
                document.body.removeChild(tempTextArea);
            };

            // メンバー増減時のサイドエフェクト
            useEffect(() => {
                if (members.length > 0) {
                    if (!expensePayerId || !members.some(m => m.id === expensePayerId)) {
                        setExpensePayerId(members[0].id);
                    }
                } else {
                    setExpensePayerId('');
                }
            }, [members, expensePayerId]);

            // --- 計算コアエンジン ---
            const calculations = useMemo(() => {
                if (members.length < 2) {
                    return {
                        memberBalances: [],
                        totalExpense: 0,
                        transactions: [],
                    };
                }

                const paidAmounts = {};
                const shareAmounts = {};
                
                members.forEach(m => {
                    paidAmounts[m.id] = 0;
                    shareAmounts[m.id] = 0;
                });

                expenses.forEach(exp => {
                    const amount = parseFloat(exp.amount) || 0;
                    if (paidAmounts[exp.payerId] !== undefined) {
                        paidAmounts[exp.payerId] += amount;
                    }

                    if (exp.participants && exp.participants.length > 0) {
                        const share = amount / exp.participants.length;
                        exp.participants.forEach(pId => {
                            if (shareAmounts[pId] !== undefined) {
                                shareAmounts[pId] += share;
                            }
                        });
                    }
                });

                const balances = {};
                const memberBalances = members.map(m => {
                    const paid = paidAmounts[m.id] || 0;
                    const share = shareAmounts[m.id] || 0;
                    const balance = paid - share;
                    balances[m.id] = balance;
                    return {
                        id: m.id,
                        name: m.name,
                        paid,
                        share,
                        balance: Math.round(balance)
                    };
                });

                const totalExpense = expenses.reduce((sum, exp) => sum + (parseFloat(exp.amount) || 0), 0);

                const debtors = [];
                const creditors = [];

                memberBalances.forEach(mb => {
                    if (mb.balance < 0) {
                        debtors.push({ id: mb.id, name: mb.name, amount: -mb.balance });
                    } else if (mb.balance > 0) {
                        creditors.push({ id: mb.id, name: mb.name, amount: mb.balance });
                    }
                });

                debtors.sort((a, b) => b.amount - a.amount);
                creditors.sort((a, b) => b.amount - a.amount);

                const transactions = [];
                let dIdx = 0;
                let cIdx = 0;

                const tempDebtors = debtors.map(d => ({ ...d }));
                const tempCreditors = creditors.map(c => ({ ...c }));

                while (dIdx < tempDebtors.length && cIdx < tempCreditors.length) {
                    const debtor = tempDebtors[dIdx];
                    const creditor = tempCreditors[cIdx];

                    const amount = Math.min(debtor.amount, creditor.amount);
                    
                    if (amount > 0) {
                        transactions.push({
                            from: debtor.name,
                            fromId: debtor.id,
                            to: creditor.name,
                            toId: creditor.id,
                            amount: Math.round(amount)
                        });
                    }

                    debtor.amount -= amount;
                    creditor.amount -= amount;

                    if (debtor.amount < 0.5) dIdx++;
                    if (creditor.amount < 0.5) cIdx++;
                }

                return {
                    memberBalances,
                    totalExpense,
                    transactions,
                };
